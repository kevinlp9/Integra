# Copia este archivo como .env y rellena tus valores reales.
# NUNCA subas el .env real a git (ya está en .gitignore).

# Base de datos (PostgreSQL en Supabase, driver asyncpg)
# Usa el Connection Pooler (Supavisor) si tu red no tiene salida IPv6.
# Recuerda percent-encodear caracteres especiales de la contraseña ($ + . % etc.)
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# Supabase - URL del proyecto (se usa para validar los JWT vía JWKS)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Supabase - Nuevas API Keys (Dashboard > Project Settings > API Keys)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Legacy (opcional): solo si tu proyecto todavía firma JWT con secreto HS256 compartido.
# SUPABASE_JWT_SECRET=

ALGORITHM=HS256

# Autenticación propia (JWT emitido por este backend para login con
# correo/contraseña del profe y boleta/contraseña del alumno).
# ⚠️ Define un valor largo y aleatorio en producción, p.ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_super_secret_dev_key
JWT_ALGORITHM=HS256
JWT_ISSUER=integra-api
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Orígenes exactos permitidos para el frontend (separados por coma).
# ⚠️ Obligatorio: no tiene valor por defecto en el código, la app no arranca sin esto.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# CORS - (Opcional) regex para permitir previews dinámicos, ej. Vercel
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

